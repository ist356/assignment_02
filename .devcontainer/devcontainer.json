{
  "name": "IST356 Assignment 02",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "forwardPorts": [
    28888,
    28501,
    28000,
    6080
  ],
  "portsAttributes": {
    "28888": {
      "label": "Jupyter"
    },
    "28501": {
      "label": "Streamlit"
    },
    "28000": {
      "label": "FastAPI"
    },
    "6080": {
      "label": "Desktop (noVNC) - watch Playwright browsers here",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.black-formatter",
        "ms-python.pylint"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
